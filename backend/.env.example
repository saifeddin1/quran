# Local development starts its own PostgreSQL instance; leave DATABASE_URL unset.
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173

# Production: use the Neon pooled connection string and Cloudinary URL.
# DATABASE_URL=postgresql://...
# CLOUDINARY_URL=cloudinary://...
# NODE_ENV=production
# APP_ORIGIN=https://your-site.netlify.app
